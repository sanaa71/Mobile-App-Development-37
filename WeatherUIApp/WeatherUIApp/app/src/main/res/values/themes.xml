<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.WeatherUIApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/splash_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/primary_button</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@drawable/bg_gradient_sky</item>
    </style>

    <style name="Theme.WeatherUIApp.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_gradient_sky</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/splash_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
